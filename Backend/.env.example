# Free LLM (recommended when HF credits are unavailable)
# Create a free Groq key at https://console.groq.com/keys — no payment required.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face Inference Router (often requires paid credits)
# LLM_PROVIDER=huggingface
HUGGINGFACE_API_KEY=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct:cheapest

# Fully local free option (install https://ollama.com then: ollama pull qwen2.5-coder:7b)
# LLM_PROVIDER=ollama
# OLLAMA_API_URL=http://127.0.0.1:11434/v1/chat/completions
# OLLAMA_MODEL=qwen2.5-coder:7b

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=salesdb
FRONTEND_URL=https://your-frontend.onrender.com

# Neo4j (Business Graph — Step 3B)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
